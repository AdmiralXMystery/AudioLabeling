<Window x:Class="AudioDataLabeling.WindowButtonEditor"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AudioDataLabeling"
        mc:Ignorable="d"
        WindowStartupLocation="CenterOwner"
        Title="Button Editor" Height="550" Width="900">
    <Window.Resources>
        <Style TargetType="Button" x:Key="EditorButtonStyle">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <!-- Border связывает свойства кнопки с визуальным отображением -->
                        <Border x:Name="border" 
                Background="{TemplateBinding Background}" 
                BorderBrush="{TemplateBinding BorderBrush}" 
                BorderThickness="{TemplateBinding BorderThickness}" 
                Padding="{TemplateBinding Padding}" 
                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <!-- Триггеры для изменения состояний -->
                        <ControlTemplate.Triggers>
                            <!-- 1. Наведение курсора -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#BEE6FD"/>
                            </Trigger>

                            <!-- 2. Нажатие кнопки -->
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#8fffb0"/>
                                <Setter Property="Foreground" Value="Black"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="2*"/>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="1*"/>
            </Grid.RowDefinitions>
            <StackPanel Margin="15 100 15 15" Grid.Row="0" VerticalAlignment="Top">
                <TextBox x:Name="ButtonNameField" Height="25"
                                 VerticalAlignment="Top" FontSize="14"
                                 LostFocus="ButtonNameField_LostFocus" KeyDown="TextBox_KeyDown">
                    <TextBox.Style>
                        <Style TargetType="TextBox">
                            <!-- Цвет по умолчанию -->
                            <Setter Property="Background" Value="#FFEEEEEE"/>
                            <Style.Triggers>
                                <!-- Если в Tag записано "Error", красим в светло-красный -->
                                <Trigger Property="Tag" Value="Error">
                                    <Setter Property="Background" Value="#FFF2D6D6"/>
                                    <Setter Property="BorderBrush" Value="Red"/>
                                    <Setter Property="BorderThickness" Value="1.5"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>
                <TextBlock x:Name="ErrorMessageLabel" Foreground="Red" FontSize="11" Margin="2 4 0 0" 
               TextWrapping="Wrap" Visibility="Collapsed"/>
            </StackPanel>
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="CountButtonText" Grid.Column="0" Text="{Binding ElementName=CountButtonSlider, Path=Value, StringFormat={}{0:0}}" FontSize="16" Margin="15 12 5 15"/>
                <Slider Grid.Column="1" Margin="5 15 5 15" IsMoveToPointEnabled="True" Minimum="2" Maximum="20"
                            x:Name="CountButtonSlider"
                            IsSelectionRangeEnabled="True"
                            SelectionStart="0"
                            TickFrequency="1"
                            IsSnapToTickEnabled="True"
                            SelectionEnd="{Binding RelativeSource={RelativeSource Self}, Path=Value}"/>
                <TextBlock Grid.Column="2" Text="20" Margin="5 12 5 15" FontSize="16"/>
            </Grid>
            <Button x:Name="WBE_Ok" Style="{StaticResource EditorButtonStyle}" Grid.Row="2" Click="WBE_Ok_Click" Margin="15" Content="Ok" FontSize="18" Width="150" Height="35" Background="White"/>
        </Grid>
        <Border Grid.Column="1" Margin="15" Background="#FFAAD7FF" CornerRadius="15">
            <UniformGrid x:Name="ButtonsContainer" Columns="2" Margin="5"/>
        </Border>
    </Grid>
</Window>
