<Window x:Class="AudioDataLabeling.WindowSettings"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AudioDataLabeling"
        mc:Ignorable="d"
        WindowStartupLocation="CenterOwner"
        Title="Settings" Height="500" Width="850">
    <Grid>
        <Border Margin="15" BorderBrush="Gray" BorderThickness="1">
            <Grid Margin="15">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Horizontal">
                    <TextBlock Text="Number of loops:" VerticalAlignment="Center" FontSize="14"/>
                    <TextBlock x:Name="CurrentNumberLoops_TextBlock" Width="20" TextAlignment="Right" VerticalAlignment="Center" Text="{Binding ElementName=NumberOfLoops_Slider, Path=Value, StringFormat={}{0:0}}" FontSize="14"/>
                    <Slider x:Name="NumberOfLoops_Slider" Width="300" VerticalAlignment="Center" Margin="10 0 10 0" Minimum="1" Maximum="10" IsMoveToPointEnabled="True" 
                            IsSelectionRangeEnabled="True" SelectionStart="0" 
                            TickFrequency="1" IsSnapToTickEnabled="True"
                            SelectionEnd="{Binding RelativeSource={RelativeSource Self}, Path=Value, StringFormat={}{0:P0}}"/>
                    <TextBlock Text="10" FontSize="14" VerticalAlignment="Center"/>
                    <CheckBox x:Name="MuliTreadedRenderingWF" Content="Multithreaded Rendering Waveform" VerticalAlignment="Center" FontSize="14" Margin="40 0 0 0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Grid.Row="1">
                    <TextBlock Margin="15" Text="Audio Devices: " VerticalAlignment="Center" FontSize="14"/>
                    <ComboBox x:Name="Devices_ComboBox" Margin="15 0 0 0 "  Width="200" Height="30" DisplayMemberPath="Name" SelectedValuePath="Id"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Grid.Row="2">
                    <TextBlock Margin="15" Text="Latency: " VerticalAlignment="Center" FontSize="14"/>
                    <TextBlock Margin="15 0 5 0" Width="25" VerticalAlignment="Center" FontSize="14" TextAlignment="Right" Text="{Binding ElementName=Latency_Slider, Path=Value, StringFormat={}{0:0}}"/>
                    <Slider x:Name="Latency_Slider" Margin="10 0 10 0" Minimum="10" Maximum="200" VerticalAlignment="Center" Width="300"
                            IsSelectionRangeEnabled="True" SelectionStart="0" TickFrequency="5" IsSnapToTickEnabled="True"
                            SelectionEnd="{Binding RelativeSource={RelativeSource Self}, Path=Value, StringFormat={}{0:P0}}"/>
                    <TextBlock VerticalAlignment="Center" Margin="0" Text="200" FontSize="14"/>
                </StackPanel>
                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="5*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Margin="15" Text="Audio Folder: " VerticalAlignment="Center" FontSize="14"/>
                    <TextBox x:Name="AudioFolder_TextBox" Grid.Column="1" IsReadOnly="True" VerticalAlignment="Center" FontSize="14" Height="25" Background="#FFEEEEEE"/>
                </Grid>
                <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="5*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Margin="15" Text="JSON File Path: " VerticalAlignment="Center" FontSize="14"/>
                    <TextBox Grid.Column="1" IsReadOnly="True" x:Name="JSONfilePath_Field" Height="25" VerticalAlignment="Center" FontSize="14">
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Setter Property="Background" Value="#FFEEEEEE"/>
                                <Style.Triggers>
                                    <Trigger Property="Tag" Value="Error">
                                        <Setter Property="Background" Value="#FFF2D6D6"/>
                                        <Setter Property="BorderBrush" Value="Red"/>
                                        <Setter Property="BorderThickness" Value="1.5"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                    <TextBlock x:Name="ErrorMessageLabel" Grid.Column="1" VerticalAlignment="Bottom" Foreground="Red" FontSize="11" Margin="2 4 0 0" TextWrapping="Wrap" Visibility="Collapsed"/>
                </Grid>
                <Grid Grid.Row="5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="Import JSON" Height="30" BorderThickness="1" Click="ImportJSON_Click"/>
                    <Button Grid.Column="1" Content="Create JSON" Height="30" BorderThickness="1" Click="CreateJSONfile_Click"/>
                    <Button Grid.Column="2" Content="Show in Explorer" Height="30" BorderThickness="1" Click="ShowInExplorer_Click"/>
                </Grid>
                <Button Grid.Row="6" Height="30" Width="100"  HorizontalAlignment="Center" 
                        x:Name="BtnOk" Background="white" Content="Save and Exit" FontSize="14" Click="SaveAndExit_Click"/>
            </Grid>
         </Border>
    </Grid>
</Window>
