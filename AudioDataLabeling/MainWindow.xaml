<Window x:Class="AudioDataLabeling.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AudioDataLabeling"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="Window_PreviewKeyDown"
        Title="Audio Data Labeling" Height="650" Width="1080">
    <Window.Resources>
        <Style TargetType="Button" x:Key="LabelButtonStyle">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <!-- Border связывает свойства кнопки с визуальным отображением -->
                        <Border x:Name="border" 
                        Background="{TemplateBinding Background}" 
                        BorderBrush="{TemplateBinding BorderBrush}" 
                        BorderThickness="{TemplateBinding BorderThickness}" 
                        Padding="{TemplateBinding Padding}" 
                        CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <!-- Триггеры для изменения состояний -->
                        <ControlTemplate.Triggers>
                            <!-- 1. Наведение курсора -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#BEE6FD"/>
                            </Trigger>

                            <!-- 2. Нажатие кнопки -->
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#8fffb0"/>
                                <Setter Property="Foreground" Value="Black"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <Style TargetType="Button" x:Key="PlayerButtonStyle">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <!-- Border связывает свойства кнопки с визуальным отображением -->
                        <Border x:Name="border" 
                            Background="{TemplateBinding Background}" 
                            BorderBrush="{TemplateBinding BorderBrush}" 
                            BorderThickness="{TemplateBinding BorderThickness}" 
                            Padding="{TemplateBinding Padding}" 
                            CornerRadius="3">
                            
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- 1. Наведение курсора -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="White"/>
                            </Trigger>

                            <!-- 2. Нажатие кнопки -->
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="White"/>
                                <Setter Property="Foreground" Value="#00ff4b"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 1. ВЕРХНЕЕ МЕНЮ -->
        <Menu Grid.Row="0" Background="White" Margin="5,0">
            <MenuItem Header="File">
                <MenuItem x:Name="MenuOpenFolder" Header="Open Folder" Click="MenuOpenFolder_Click"/>
                <MenuItem x:Name="MenuSave" Header="Save" Click="MenuSave_Click"/>
            </MenuItem>
            <MenuItem Header="Editor" Click="MenuItemEditor_Click"/>
            <MenuItem Header="Settings" Click="MenuItemSettings_Click"/>
            <MenuItem Header="Visualization" Click="Vizialization_Click"/>
            <MenuItem Header="Reader" Click="Reader_Click"/>
        </Menu>

        <!-- ОСНОВНОЙ КОНТЕНТ -->
        <Grid Grid.Row="1" Margin="15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="13*"/>
                <ColumnDefinition Width="62*"/>
                <ColumnDefinition Width="75*"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Grid.ColumnSpan="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBox Grid.Row="0" x:Name="SearchFile_TextBox" 
                         Text="🔍 Start typing to search by name or click the markup button..." 
                         FontSize="14" Height="30" VerticalContentAlignment="Center" 
                         Background="#FFF6F6F6" Foreground="Gray"
                         GotFocus="SearchFile_TextBox_GotFocus"
                         LostFocus="SearchFile_TextBox_LostFocus"
                         TextChanged="SearchFile_TextBox_TextChanged" KeyDown="TextBox_KeyDown"/>
                <ListBox x:Name="MusicListBox" Grid.Row="1" Background="White"
                         BorderBrush="Gray" BorderThickness="1" Focusable="False"
                         MouseDoubleClick="MusicListBox_MouseDoubleClick"
                         VirtualizingStackPanel.IsVirtualizing="True"
                         VirtualizingStackPanel.VirtualizationMode="Recycling"
                         ScrollViewer.CanContentScroll="True" SelectionChanged="MusicListBox_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="2">
                                <Ellipse x:Name="Indicator" Width="8" Height="8" 
                                Fill="Transparent" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding FileName}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding AssignedLabel}" 
                                           VerticalAlignment="Center" 
                                           Margin="15,0,0,0" 
                                           Foreground="#888888" 
                                           FontSize="12" 
                                           FontStyle="Italic"/>
                            </StackPanel>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsDone}" Value="True">
                                    <Setter TargetName="Indicator" Property="Fill" Value="#4CAF50"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsDone}" Value="False">
                                    <Setter TargetName="Indicator" Property="Fill" Value="#E0E0E0"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Grid Grid.Row="2" x:Name="WaveformGrid" Height="0" VerticalAlignment="Center">
                    <Border BorderBrush="Black" BorderThickness="1">
                        <Grid>
                            <TextBlock x:Name="WaveFormInfo" 
                                       HorizontalAlignment="Center" 
                                       VerticalAlignment="Center" 
                                       Foreground="Black" 
                                       FontSize="18" 
                                       FontWeight="SemiBold"/>
                            <Image x:Name="WaveformImage" Stretch="Fill"/>
                        </Grid>
                    </Border>
                    <Border x:Name="PlaybackMarker" 
                                    Width="2" 
                                    Background="#FFFF0000" HorizontalAlignment="Left"
                                    Visibility="Collapsed">
                        <Border.Effect>
                            <DropShadowEffect Color="Red" BlurRadius="4" ShadowDepth="0" Opacity="0.7"/>
                        </Border.Effect>
                    </Border>
                </Grid>
                <Button x:Name="ButtonFieldInfo" Grid.Row="3" Height="25" HorizontalContentAlignment="Center" FontSize="12" FontWeight="SemiBold" Background="White" Focusable="False" Click="ButtonFieldInfo_Click"/>
            </Grid>

            <Grid Grid.Column="2" Margin="15,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="8*"/>
                    <RowDefinition Height="0.9*"/>
                    <RowDefinition Height="0.9*"/>
                    <RowDefinition Height="1.2*"/>
                    <RowDefinition Height="0.9*"/>
                </Grid.RowDefinitions>

                <!-- 2. СЕТКА КНОПОК РАЗМЕТКИ (В голубой рамке) -->
                <Border Grid.Row="0" Background="#FFAAD7FF" CornerRadius="8" Padding="6">
                    <UniformGrid x:Name="ButtonsContainer" Columns="2"/>
                </Border>

                <Canvas x:Name="TrackNameCanvas" Grid.Row="1" Height="25" Margin="0 10 0 0" ClipToBounds="True" Background="Transparent" SizeChanged="TrackNameCanvas_SizeChanged">
                    <StackPanel x:Name="TxtTrackNamePanel" Orientation="Horizontal" Canvas.Left="0" Canvas.Top="2">
                        <StackPanel.RenderTransform>
                            <TranslateTransform x:Name="TextTranslate"/>
                        </StackPanel.RenderTransform>
                        <TextBlock x:Name="TxtTrackName1" FontSize="14" FontWeight="SemiBold" Foreground="#333333"/>
                        <TextBlock x:Name="TxtSeparator" Text="   •   " FontSize="14" FontWeight="SemiBold" Foreground="#888888" Visibility="Collapsed"/>
                        <TextBlock x:Name="TxtTrackName2" FontSize="14" FontWeight="SemiBold" Foreground="#333333" Visibility="Collapsed"/>
                    </StackPanel>
                </Canvas>

                <Grid Grid.Row="2" Margin="0,10,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="LeftTimeText" Text="00:00.00" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,5,0" Foreground="#333333"/>
                    <Slider Grid.Column="1" VerticalAlignment="Center" Height="20" Minimum="0" Maximum="100" Value="0" IsMoveToPointEnabled="True"
                            x:Name="TimeLineSlider"
                            IsSelectionRangeEnabled="True"
                            SelectionStart="0"
                            SelectionEnd="{Binding RelativeSource={RelativeSource Self}, Path=Value}"
                            ValueChanged="TimeLineSlider_ValueChanged" FocusVisualStyle="{x:Null}"/>

                    <TextBlock x:Name="RightTimeText" Grid.Column="2" Text="00:00.00" VerticalAlignment="Center" Margin="5,0,0,0" Foreground="#333333"/>
                </Grid>

                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="1.2*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="2*"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="BtnClear" Grid.Column="0" Width="50" Height="40" Content="Clear" FontSize="15" Background="White" Foreground="Black" BorderThickness="0" Margin="0,8,0,7" HorizontalAlignment="Center" Click="BtnClear_Click"/>

                    <Button x:Name="BtnBack" Style="{StaticResource PlayerButtonStyle}" Focusable="False" Grid.Column="1" Content="◀◀" FontSize="24" Background="White" BorderThickness="0" VerticalAlignment="Center" Padding="10,0" Click="BtnBack_Click"/>
                    <Button x:Name="BtnPlayStop" Style="{StaticResource PlayerButtonStyle}" Grid.Column="2" Content="▶" FontSize="40" Background="White" BorderThickness="0" VerticalAlignment="Center" HorizontalAlignment="Center" Click="PlayStop_Click"/>
                    <Button x:Name="BtnNext" Style="{StaticResource PlayerButtonStyle}" Focusable="False" Grid.Column="3" Content="▶▶" FontSize="24" Background="White" BorderThickness="0" VerticalAlignment="Center" Padding="10,0" Click="BtnNext_Click"/>

                    <ToggleButton x:Name="BtnLoop" Grid.Column="4" Width="50" Height="40" Content="Loop" FontSize="15" Background="White" Foreground="Black" BorderThickness="0" Margin="0,8,0,7" HorizontalAlignment="Center"/>
                </Grid>

                <Grid Grid.Row="4" VerticalAlignment="Bottom" Margin="20,0,20,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" VerticalAlignment="Center" Width="32" TextAlignment="Right" Margin="0,0,10,0" Foreground="#333333" Text="{Binding ElementName=VolumeSlider, Path=Value, StringFormat={}{0:P0}}"/>
                    <Slider Grid.Column="1" Value="1" Minimum="0" Maximum="1" VerticalAlignment="Center" IsMoveToPointEnabled="True"
                            x:Name="VolumeSlider"
                            IsSelectionRangeEnabled="True"
                            SelectionStart="0"
                            SelectionEnd="{Binding RelativeSource={RelativeSource Self}, Path=Value, StringFormat={}{0:P0}}"
                            ValueChanged="VolumeSlider_ValueChanged"/>
                    <TextBlock Grid.Column="2" Text="100%" Width="32" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="#333333"/>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>