<Window x:Class="AudioDataLabeling.WindowSaving"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AudioDataLabeling"
        mc:Ignorable="d"
        WindowStartupLocation="CenterOwner"
        Title="WindowSaving" Height="400" Width="650">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="3*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" VerticalAlignment="Center">
            <StatusBar>
                <StatusBar.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                        </Grid>
                    </ItemsPanelTemplate>
                </StatusBar.ItemsPanel>

                <StatusBarItem Grid.Row="0" HorizontalContentAlignment="Stretch">
                    <Grid>
                        <ProgressBar x:Name="LoadProgressBar" Height="30" Minimum="0" Maximum="100" Value="0" Visibility="Visible"/>
                        <TextBlock x:Name="TextProgressBar"
                           Foreground="Black" 
                           FontWeight="SemiBold"
                           FontSize="16"
                           HorizontalAlignment="Center" 
                           VerticalAlignment="Center"/>
                    </Grid>
                </StatusBarItem>
            </StatusBar>
        </Grid>
        <TextBox x:Name="SavingLogs" Grid.Row="1" Margin="5" FontSize="12" IsReadOnly="True" VerticalScrollBarVisibility="Auto"/>
        <Border Background="#FFAAD7FF" Grid.Row="2" CornerRadius="15" Margin="10">
        <Button x:Name="BtnOk"  Content="Ok" Height="30" Margin="10 0 10 0" FontSize="12" FocusVisualStyle="{x:Null}"/>
        </Border>
    </Grid>
</Window>
