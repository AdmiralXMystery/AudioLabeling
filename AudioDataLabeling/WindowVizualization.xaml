<Window x:Class="AudioDataLabeling.WindowVizualization"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
        xmlns:local="clr-namespace:AudioDataLabeling"
        WindowStartupLocation="CenterOwner"
        mc:Ignorable="d"
        Title="WindowVizualization" Height="450" Width="800">
    <Window.Resources>
        <!-- Стиль для того, чтобы заголовки занимали всё пространство UniformGrid -->
        <Style TargetType="TabItem">
            <Setter Property="HeaderTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <!-- ContentPresenter автоматически и правильно отобразит текст "📊 Столбчатая" -->
                        <ContentPresenter Content="{TemplateBinding Content}" 
                                  HorizontalAlignment="Center" 
                                  VerticalAlignment="Center" 
                                  Margin="0,8"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="#E9ECEF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
        </Style>



        <!-- Стиль для самого TabControl, заставляющий вкладки делиться поровну -->
        <Style TargetType="TabControl">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid KeyboardNavigation.TabNavigation="Local">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- UniformGrid с Rows="1" автоматически делит ширину на N частей -->
                            <UniformGrid IsItemsHost="True" Rows="1" Grid.Row="0"/>

                            <ContentPresenter x:Name="PART_SelectedContentHost" Grid.Row="1" 
                                          ContentSource="SelectedContent"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="#F8F9FA">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок окна -->
        <TextBlock Text="Audio distribution analytics by category" 
                   FontSize="16" FontWeight="SemiBold" Foreground="#495057"
                   HorizontalAlignment="Center" Margin="20,15,0,10"/>

        <!-- Панель вкладок а-ля браузер -->
        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0" Margin="10,0,10,10">

            <!-- Вкладка 1: Столбчатая -->
            <TabItem Header="📊 Вar Сhart">
                <Border Background="White" CornerRadius="0,8,8,8" Padding="15">
                    <lvc:CartesianChart Series="{Binding ColumnSeries}" XAxes="{Binding XAxes}" YAxes="{Binding YAxes}" />
                </Border>
            </TabItem>

            <!-- Вкладка 2: Круговая -->
            <TabItem Header="🍕 Pie Chart">
                <Border Background="White" CornerRadius="0,8,8,8" Padding="15">
                    <!-- LegendPosition выводит расшифровку секторов справа -->
                    <lvc:PieChart Series="{Binding PieSeries}" LegendPosition="Right" />
                </Border>
            </TabItem>

            <!-- Вкладка 3: Радарная -->
            <TabItem Header="🕸️ Polar Chart">
                <Border Background="White" CornerRadius="0,8,8,8" Padding="15">
                    <lvc:PolarChart Series="{Binding RadarSeries}" AngleAxes="{Binding RadarAngleAxes}" RadiusAxes="{Binding RadarRadiusAxes}" />
                </Border>
            </TabItem>

        </TabControl>
    </Grid>
</Window>
